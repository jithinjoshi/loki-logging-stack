{
  "uid": "express-logs",
  "title": "App Logs",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Service",
        "type": "custom",
        "query": "users,express-app",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "info,warn,error",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": ""
      },
      {
        "name": "search",
        "label": "Search (any text, case-insensitive)",
        "type": "textbox",
        "query": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, level) (count_over_time({job=~\"$job\", level=~\"$level\"}[$__auto]))",
          "legendFormat": "{{job}} {{level}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors (selected range)",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=~\"$job\", level=\"error\"}[$__auto]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=~\"$job\", level=~\"$level\"} |~ `(?i)${traceId:regex}` |~ `(?i)${search:regex}`"
        }
      ]
    }
  ]
}
