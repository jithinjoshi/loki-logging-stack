# Copy to .env and fill in. Never commit .env.

# Secret key every app must send to push logs (Authorization: Bearer <key>)
LOG_INGEST_KEY=

# Public URL of Grafana (used for the links in alert emails)
GRAFANA_URL=http://localhost:3001

# Alert emails: comma-separated recipients
ALERT_EMAILS=

# SMTP for alert emails. Leave empty to use the local Mailpit inbox (http://localhost:8025)
SMTP_HOST=smtp.sendgrid.net:587
SMTP_USER=apikey
SMTP_PASSWORD=
SMTP_FROM=alerts@pekoapp.com
